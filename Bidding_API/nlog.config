<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">
  <!-- the targets to write -->
  <targets>
    <!-- write to file -->
    <target name="applog" xsi:type="File"
    fileName="${basedir}/logs/apilogs.txt"            
    layout="${longdate} ${newline} ${message} ${newline} 
        ${exception:format=StackTrace}${newline}"             
    archiveFileName="${basedir}/logs/archives/apilog.{#}.txt"
    archiveEvery="Day"
    archiveNumbering="Date"
    archiveDateFormat="yyyy-MM-dd"     
    maxArchiveFiles="10"/>

    <!-- Configuration to remove Microsoft -->
    <target xsi:type="Null" name="blackHole" />
    
    <!--<target xsi:type="File"
        name="archive"
        archiveEvery="Day"
        archiveFileName = "nlogdemo-{########}.log"
        archiveNumbering = "Date"
        archiveDateFormat = "yyyyMMdd"
        maxArchiveFiles = "4"
        fileName="nlogdemo.log"
        layout="${longdate}|${level:uppercase=true}|${logger}|${message}" />-->

    <!--<target name="file"
        xsi:type="File"
        fileName="${basedir}/../logs/${shortdate}.log"
        archiveFileName="${basedir}/../logs/archive/archive.${shortdate}.{#}.txt"
        archiveAboveSize="51200"
        archiveNumbering="Rolling"
        maxArchiveFiles="14" />-->
    
  </targets>
  <!-- rules to map from logger name to target -->
  <rules>
    <!-- Configuration to remove Microsoft -->
    <logger name="Microsoft.*" minlevel="Info" writeTo="blackHole" final="true" />
    <!-- all logs including -->   
    <logger name="*" minlevel="Trace" writeTo="applog" />
  </rules>
</nlog>